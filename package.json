{
  "name": "play_ts_cucumber",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "pretest":"",
    "test": "cucumber-js --require-module ts-node/register --require \"test/**/*.ts\"",
    "posttest":"npm run report",
    "report": "npm run report:generate && npm run report:open",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report:serve": "allure serve allure-results",
    "test-failed": "cucumber-js -p rerun @rerun.txt"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "allure-commandline": "^2.46.1",
    "allure-cucumberjs": "^3.13.0",
    "allure-playwright": "^3.13.0",
    "multiple-cucumber-html-reporter": "^4.4.2",
    "playwright": "^1.64.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "pnpm": "^12.10.1"
  }
}