{
    "default": {
        "formatOptions": {
            "snippetInterface": "async-await",
             "resultsDir": "allure-results"
        },
        "paths": [
            "src/test/features/"
        ],
        "publishQuit": true,
        "dryRun": false,
        "timeout": 30000,
        "parallel": 2,
        "retry": 1,
        "require": [
            "src/test/**/*.ts"
        ],
        "requireModule": [
            "ts-node/register"
        ],
        "format": [
            "progress-bar",
            "allure-cucumberjs/reporter",
            "rerun:@rerun.txt"
        ]
    },

    "rerun": {
        "formatOptions": {
            "snippetInterface": "async-await",
             "resultsDir": "allure-results"
        },
        "publishQuit": true,
        "dryRun": false,
        "timeout": 30000,
        "parallel": 2,
        "require": [
            "src/test/**/*.ts"
        ],
        "requireModule": [
            "ts-node/register"
        ],
        "format": [
            "progress-bar",
            "allure-cucumberjs/reporter"
        ]
    }
}